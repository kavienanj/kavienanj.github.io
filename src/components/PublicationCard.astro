---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  publication: CollectionEntry<"publications">;
}

const { publication } = Astro.props;
const { title, authors, venue, year, status, links } = publication.data;
const { Content } = await render(publication);

const statusLabel: Record<string, string> = {
  submitted: "Under Review",
  "in-prep": "In Preparation",
  published: "Published",
};

const statusClass: Record<string, string> = {
  submitted: "bg-accent/10 text-accent",
  "in-prep": "bg-text-muted/10 text-text-muted",
  published: "bg-accent text-white",
};
---

<article class="py-6 border-b border-border last:border-none">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <h3 class="font-serif text-lg font-semibold leading-snug">{title}</h3>
    <span class={`shrink-0 text-xs px-2 py-1 rounded-full font-medium ${statusClass[status]}`}>
      {statusLabel[status]}
    </span>
  </div>
  <p class="text-sm text-text-muted mt-1">{authors}</p>
  <p class="text-sm text-text-muted italic">
    {venue ? venue : "Target venue to be determined"} &middot; {year}
  </p>

  {
    links && (links.pdf || links.arxiv || links.code) && (
      <p class="text-sm mt-2 flex gap-4">
        {links.pdf && <a href={links.pdf} target="_blank" rel="noopener noreferrer">PDF</a>}
        {links.arxiv && <a href={links.arxiv} target="_blank" rel="noopener noreferrer">arXiv</a>}
        {links.code && <a href={links.code} target="_blank" rel="noopener noreferrer">Code</a>}
      </p>
    )
  }

  <details class="mt-2 text-sm">
    <summary class="cursor-pointer text-text-muted hover:text-accent transition-colors select-none">
      Abstract
    </summary>
    <div class="mt-2 text-text-muted leading-relaxed">
      <Content />
    </div>
  </details>
</article>
