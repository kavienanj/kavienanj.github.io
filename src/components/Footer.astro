---
import SocialLinks from "./SocialLinks.astro";
import { site } from "../data/social";

const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="mx-auto max-w-4xl px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-sm text-text-muted text-center sm:text-left">
      <p>{site.name} &middot; {site.location}</p>
      <p>&copy; {year}. Built with Astro.</p>
    </div>
    <SocialLinks iconClass="h-5 w-5" />
  </div>
</footer>
