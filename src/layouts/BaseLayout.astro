---
import { getImage } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, socialLinks } from "../data/social";
import avatar from "../assets/avatar.png";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedDate?: Date;
  tags?: string[];
}

const {
  title,
  description = "Kavienan Jegatheesan, a cybersecurity researcher focused on Secure Software Development, Trustworthy AI, and emerging threats in agentic systems.",
  image,
  article = false,
  publishedDate,
  tags,
} = Astro.props;

const pageTitle = title === "Kavienan Jegatheesan" ? title : `${title} · Kavienan Jegatheesan`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Bump this whenever favicon/icon assets are replaced to bust browsers' persistent favicon cache.
const ICON_VERSION = "2";

const defaultImage = await getImage({ src: avatar, width: 1200 });
const imageURL = new URL(image ?? defaultImage.src, Astro.site);

const personSameAs = socialLinks
  .filter((link) => !link.href.startsWith("mailto:") && link.name !== "RSS Feed")
  .map((link) => link.href);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.toString(),
  jobTitle: site.role,
  affiliation: { "@type": "CollegeOrUniversity", name: site.affiliation },
  address: { "@type": "Place", name: site.location },
  email: site.email,
  sameAs: personSameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        const STORAGE_KEY = "theme";

        function getPreference() {
          const stored = localStorage.getItem(STORAGE_KEY);
          return stored === "light" || stored === "dark" ? stored : "system";
        }

        function systemPrefersDark() {
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function apply(pref) {
          const isDark = pref === "dark" || (pref === "system" && systemPrefersDark());
          document.documentElement.classList.toggle("dark", isDark);
        }

        function set(pref) {
          if (pref === "system") {
            localStorage.removeItem(STORAGE_KEY);
          } else {
            localStorage.setItem(STORAGE_KEY, pref);
          }
          apply(pref);
          window.dispatchEvent(new CustomEvent("themechange", { detail: { pref } }));
        }

        apply(getPreference());

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
          if (getPreference() === "system") apply("system");
        });

        window.__theme = { get: getPreference, set: set };
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`/favicon.ico?v=${ICON_VERSION}`} sizes="48x48" />
    <link rel="icon" href={`/favicon.svg?v=${ICON_VERSION}`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${ICON_VERSION}`} />
    <meta name="theme-color" content="#0b0f17" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s Blog`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {article && publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {article && <meta property="article:author" content={site.name} />}
    {article && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kavienanj" />
    <meta name="twitter:creator" content="@kavienanj" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <script is:inline data-goatcounter="https://kavienanj.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text font-sans antialiased">
    <Nav />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
