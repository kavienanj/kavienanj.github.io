---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, experience, skills, awards, leadership, volunteering, languages } from "../data/cv";
---

<BaseLayout title="CV" description="Curriculum vitae of Kavienan Jegatheesan — education, experience, skills, and awards.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-20">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold">Curriculum Vitae</h1>
      <div class="flex gap-3 no-print">
        <a
          href="/cv/kavienan-research-cv.pdf"
          class="text-sm px-4 py-2 rounded-md bg-accent text-white hover:bg-accent-hover transition-colors"
        >
          Research CV (PDF)
        </a>
        <a
          href="/cv/kavienan-professional-cv.pdf"
          class="text-sm px-4 py-2 rounded-md border border-border hover:border-accent hover:text-accent transition-colors"
        >
          Professional CV (PDF)
        </a>
      </div>
    </div>

    <p class="mt-4 text-text-muted max-w-2xl leading-relaxed">
      For the full list of publications, see the <a href="/publications">Publications</a> page. The sections
      below combine both my research and professional CVs; the PDFs above are the concise, print-ready versions.
    </p>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Education</h2>
      <div class="mt-4 space-y-6">
        {
          education.map((item) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-medium">{item.school} <span class="text-text-muted font-normal">— {item.location}</span></h3>
                <span class="text-sm text-text-muted">{item.period}</span>
              </div>
              <p class="text-sm text-text-muted italic">{item.degree}</p>
              <ul class="text-sm mt-1 list-disc list-inside text-text-muted">
                {item.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Experience</h2>
      <div class="mt-4 space-y-6">
        {
          experience.map((item) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-medium">{item.role} <span class="text-text-muted font-normal">— {item.org}</span></h3>
                <span class="text-sm text-text-muted">{item.period}</span>
              </div>
              <p class="text-sm text-text-muted italic">{item.type}</p>
              <ul class="text-sm mt-1 list-disc list-inside text-text-muted space-y-0.5">
                {item.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Skills</h2>
      <div class="mt-4 space-y-2">
        {
          skills.map((group) => (
            <p class="text-sm">
              <span class="font-medium">{group.label}: </span>
              <span class="text-text-muted">{group.items.join(", ")}</span>
            </p>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Awards & Honors</h2>
      <ul class="mt-4 space-y-2">
        {
          awards.map((a) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
              <span>
                <span class="font-medium">{a.title}</span>
                {a.note && <span class="text-text-muted"> — {a.note}</span>}
              </span>
              <span class="text-text-muted">{a.period}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Leadership</h2>
      <ul class="mt-4 space-y-2">
        {
          leadership.map((l) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
              <span><span class="font-medium">{l.role}</span> <span class="text-text-muted">— {l.org}</span></span>
              <span class="text-text-muted">{l.period}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Volunteering</h2>
      <ul class="mt-4 space-y-3">
        {
          volunteering.map((v) => (
            <li class="text-sm">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span><span class="font-medium">{v.role}</span> <span class="text-text-muted">— {v.org}</span></span>
                <span class="text-text-muted">{v.period}</span>
              </div>
              <p class="text-text-muted">{v.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-xl font-semibold border-b border-border pb-2">Languages</h2>
      <p class="mt-4 text-sm text-text-muted">{languages}</p>
    </section>
  </section>
</BaseLayout>
