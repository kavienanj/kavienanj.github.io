---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV" description="Download Kavienan Jegatheesan's research and professional CVs as PDF.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-20">
    <h1 class="font-serif text-3xl sm:text-4xl font-bold">Curriculum Vitae</h1>

    <div class="mt-8">
      <p class="text-text-muted leading-relaxed">
        If you're a recruiter looking to hire me,
      </p>
      <a
        href="/cv/kavienan-professional-cv.pdf"
        class="inline-block mt-3 text-sm px-4 py-2 rounded-md bg-accent text-white hover:bg-accent-hover transition-colors"
      >
        Professional CV (PDF)
      </a>
    </div>

    <hr class="my-8 border-border" />

    <div>
      <p class="text-text-muted leading-relaxed">
        If you're a researcher or professor interested in my academic work,
      </p>
      <a
        href="/cv/kavienan-research-cv.pdf"
        class="inline-block mt-3 text-sm px-4 py-2 rounded-md bg-accent text-white hover:bg-accent-hover transition-colors"
      >
        Research CV (PDF)
      </a>
    </div>
  </section>
</BaseLayout>
