---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="Blog" description="Notes and writing from Kavienan Jegatheesan on AI security, cybersecurity, and research.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-20">
    <h1 class="font-serif text-3xl sm:text-4xl font-bold">Blog</h1>
    <p class="mt-4 text-text-muted max-w-2xl leading-relaxed">
      Notes on AI security research, cybersecurity, and things I'm learning.
    </p>

    {
      posts.length === 0 ? (
        <p class="mt-16 text-text-muted italic">No posts yet — coming soon.</p>
      ) : (
        <ul class="mt-10 divide-y divide-border">
          {posts.map((post) => (
            <li class="py-6">
              <a href={`/blog/${post.id}/`} class="group">
                <h2 class="font-serif text-xl font-semibold group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-sm text-text-muted mt-1">{formatter.format(post.data.date)}</p>
                <p class="text-sm text-text-muted mt-2 leading-relaxed">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
