---
import BaseLayout from "../layouts/BaseLayout.astro";

const pillars = [
  {
    title: "Trustworthy & Reliable AI",
    body: "How do we know an AI system is telling the truth, staying within its intended bounds, and behaving predictably under pressure? I study failure modes in AI systems, from corrupted tool feedback in agentic reasoning pipelines to the gap between a model's stated confidence and its actual reliability, with the goal of building evaluation methods and safeguards that hold up outside the lab.",
  },
  {
    title: "AI Red Teaming & Emerging Threats of Agentic Systems",
    body: "As LLM-driven agents gain the ability to call tools, write code, and act autonomously across systems, they open new classes of attack and failure. My work probes these systems adversarially. It simulates autonomous exploitation, identity and revocation weaknesses in agent-to-agent protocols, and coordination failures across multi-agent and multi-host deployments, to surface risks before they surface in production.",
  },
  {
    title: "Software Supply Chain Security",
    body: "Malicious and vulnerable packages routinely evade automated scanners by gating their behavior on conditions the scanner's execution environment never satisfies. I work on systematically deriving execution environments that combine the conditions real-world malware checks for, to make dynamic analysis harder to evade.",
  },
];
---

<BaseLayout title="Research" description="Kavienan Jegatheesan's research interests span Trustworthy & Reliable AI, AI Red Teaming, agentic system security, and software supply chain security.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-12">
    <h1 class="font-serif text-3xl sm:text-4xl font-bold">Research</h1>
    <p class="mt-4 text-text-muted max-w-2xl leading-relaxed">
      I work at the intersection of cybersecurity and AI, focused on making both AI systems and the software
      supply chains they increasingly touch safer to deploy and harder to compromise. My research spans
      three connected areas.
    </p>

    <div class="mt-10 space-y-10">
      {
        pillars.map((pillar) => (
          <article>
            <h2 class="font-serif text-xl font-semibold">{pillar.title}</h2>
            <p class="mt-2 text-text-muted leading-relaxed max-w-2xl">{pillar.body}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-12 text-sm text-text-muted">
      See the full list of <a href="/publications">publications</a> for current work, or the&nbsp;
      <a href="/cv">CV</a> for the complete academic and professional background.
    </p>
  </section>
</BaseLayout>
